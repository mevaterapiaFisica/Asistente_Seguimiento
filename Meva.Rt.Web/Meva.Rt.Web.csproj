<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Meva.Rt.Core\Meva.Rt.Core.csproj" />
    <ProjectReference Include="..\Meva.Rt.Application\Meva.Rt.Application.csproj" />
    <ProjectReference Include="..\Meva.Rt.Infrastructure.SitraMed\Meva.Rt.Infrastructure.SitraMed.csproj" />
    <ProjectReference Include="..\Meva.Rt.Infrastructure.Aria\Meva.Rt.Infrastructure.Aria.csproj" />
    <ProjectReference Include="..\Meva.Rt.Infrastructure.Storage\Meva.Rt.Infrastructure.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Insumos ARIA\mapEquiposAriaSitra.txt">
      <Link>config\mapEquiposAriaSitra.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ponytail: data\ es estado runtime del servicio (vive en C:\MevaRT\data), no payload de build.
       Sin este Remove, dotnet publish copia esta carpeta local vieja de pruebas y pisa
       rt_configuration.json en vivo con una versión desactualizada en cada publish. -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
