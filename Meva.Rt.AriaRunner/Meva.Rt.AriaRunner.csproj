<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Meva.Rt.AriaRunner</RootNamespace>
    <AssemblyName>AriaRunner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Para publicar self-contained: dotnet publish -r win-x64 -p:SelfContained=true -c Release -->
  </PropertyGroup>

  <ItemGroup>
    <!-- EF 6.4.4 soporta .NET Standard 2.0 → compatible con .NET 9 -->
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AriaQ">
      <HintPath>..\..\Insumos ARIA\AriaQ.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="sample_input.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
