<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <RootNamespace>Meva.Rt.AriaRunner</RootNamespace>
    <AssemblyName>AriaRunner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- net48: corre en Windows 7 SP1+ con .NET Framework 4.8 -->
    <!-- Para publicar net48: dotnet publish -f net48 -c Release -o publish\net48 -->
    <!-- Para publicar net9 self-contained: dotnet publish -f net9.0 -r win-x64 -p:SelfContained=true -c Release -o publish\net9 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- EF 6.4.4 soporta .NET Standard 2.0 → compatible con .NET 9 -->
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AriaQ">
      <HintPath>..\..\Insumos ARIA\AriaQ.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="sample_input.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
